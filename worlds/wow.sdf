<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="ice_challenge_world">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="world_lightq_source">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>3.2 3.2</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>3.2 3.2</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="perimeter">
      <static>true</static>
      <link name="wall_n">
        <pose>0 1.6 0.15 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>3.2 0.05 0.3</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>3.2 0.05 0.3</size></box></geometry>
          <material><ambient>0 0.4 0.8 1</ambient></material>
        </visual>
      </link>
      <link name="wall_s">
        <pose>0 -1.6 0.15 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>3.2 0.05 0.3</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>3.2 0.05 0.3</size></box></geometry>
          <material><ambient>0 0.4 0.8 1</ambient></material>
        </visual>
      </link>
      <link name="wall_e">
        <pose>1.6 0.35 0.15 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.05 3.2 0.3</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.05 3.2 0.3</size></box></geometry>
          <material><ambient>0 0.4 0.8 1</ambient></material>
        </visual>
      </link>
      <link name="wall_w">
        <pose>-1.6 0 0.15 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.05 3.2 0.3</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.05 3.2 0.3</size></box></geometry>
          <material><ambient>0 0.4 0.8 1</ambient></material>
        </visual>
      </link>
    </model>


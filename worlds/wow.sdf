          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular><pbr><metal><metalness>0.0</metalness><roughness>1.0</roughness><albedo_map>aruco_marker0.png</albedo_map></metal></pbr></material>
